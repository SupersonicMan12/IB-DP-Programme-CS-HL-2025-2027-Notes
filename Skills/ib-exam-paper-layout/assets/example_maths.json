    {
      "type": "question",
      "number": 3,
      "blocks": [
        {
          "type": "text",
          "text": "Let $f(x) = x^3 - 3x$. The following diagram shows part of the graph of $y = f(x)$. The shaded region $R$ is enclosed by the graph of $f$ and the $x$-axis, between $x = 0$ and $x = \\sqrt3$."
        },
        {
          "type": "image",
          "path": "example_math_graph.png",
          "width_cm": 9.5,
          "caption": "<i>diagram not to scale</i>"
        },
        {
          "type": "parts",
          "parts": [
            {
              "label": "a",
              "text": "Show that $f'(x) = 3x^2 - 3$.",
              "marks": 1
            },
            {
              "label": "b",
              "text": "Find the $x$-coordinates of the points on the graph of $f$ where the tangent is horizontal.",
              "marks": 3
            },
            {
              "label": "c",
              "subparts": [
                {
                  "label": "i",
                  "text": "Find the value of",
                  "marks": 3,
                  "blocks": [
                    {
                      "type": "equation",
                      "latex": "\\int_0^{\\sqrt{3}} \\left(x^3 - 3x\\right)\\,\\mathrm{d}x"
                    }
                  ]
                },
                {
                  "label": "ii",
                  "text": "Hence write down the area of $R$.",
                  "marks": 1
                }
              ]
            }
          ]
        }
      ]
    }
  ],
