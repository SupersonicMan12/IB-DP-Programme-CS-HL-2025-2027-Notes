          "type": "text",
          "text": "Let $f(x) = 2x^2 - 8x + 3$."
        },
        {
          "type": "parts",
          "parts": [
            {
              "label": "a",
              "text": "Find $f'(x)$.",
              "marks": 2,
              "lines": 3
            },
            {
              "label": "b",
              "text": "Hence find the coordinates of the vertex of the graph of $f$.",
              "marks": 3,
              "lines": 5
            },
            {
              "label": "c",
              "text": "Write down the equation of the axis of symmetry of the graph of $f$.",
              "marks": 1,
              "lines": 2
            }
          ]
        }
      ]
    },
    {
      "type": "question",
      "number": 2,
      "blocks": [
        {
          "type": "text",
          "text": "The first term of an arithmetic sequence is 7 and the fifth term is 19."
        },
        {
          "type": "parts",
          "parts": [
            {
              "label": "a",
              "text": "Find the common difference, $d$.",
              "marks": 2,
              "lines": 3
            },
            {
              "label": "b",
              "text": "Find the sum of the first 20 terms of the sequence.",
              "marks": 3,
              "lines": 4
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "Section B",
      "new_page": true,
      "text": "Answer <b>all</b> questions on separate paper."
